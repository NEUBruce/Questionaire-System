server:
  port: 8085

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/neusql?serverTimeZone=Asia/Shanghai&characterEncoding=utf-8
    username: root
    password: "your_password_here"
    driver-class-name: com.mysql.cj.jdbc.Driver

mybatis:
  type-aliases-package: com.sisp.dao.entity
  mapper-locations: classpath:/mapper/*.xml

  configuration:
    cache-enabled: true